# =============================================================================
# IoT Simulator — Environment Variables Template
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string for the HealthGuard production DB.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/healthguard

# ---------------------------------------------------------------------------
# HealthGuard Backend (health_system)
# ---------------------------------------------------------------------------
# Base URL of the HealthGuard backend that the simulator pushes telemetry to.
# Use 127.0.0.1 (not localhost) to avoid IPv6 resolution delay on Windows.
HEALTH_BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Pre-model trigger pipeline
# ---------------------------------------------------------------------------
# Set to 1 to enable the fall/risk pre-trigger orchestrator.
PRE_MODEL_TRIGGER_ENABLED=0

# Set to 1 to allow the orchestrator to call the AI model API.
PRE_MODEL_TRIGGER_ENABLE_MODEL_CALLS=0

# Set to 1 to pull risk thresholds from the DB instead of built-in defaults.
USE_DB_THRESHOLDS=0

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Admin API key for protected endpoints (/api/sim/admin/*).
# Leave empty in dev mode — all admin requests will be allowed without auth.
SIM_ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Set to 0 to disable rate limiting (dev/test only).
SIM_RATE_LIMIT_ENABLED=1

# Max requests per minute for read methods (GET/HEAD/OPTIONS). Default: 60.
# SIM_RATE_LIMIT_READ=60

# ---------------------------------------------------------------------------
# Frontend (Vite) — place in simulator-web/.env
# ---------------------------------------------------------------------------
# These variables are read at build time by Vite.
# Create simulator-web/.env (also gitignored) with the values below.

# VITE_API_BASE_URL=http://localhost:8090
# VITE_WS_BASE_URL=ws://localhost:8090
# VITE_POLL_INTERVAL_DEVICES=5000
